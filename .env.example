# 复制为 .env 并填入真实值（.env 切勿提交仓库；.gitignore 已忽略 *.env.local，请自行确保 .env 不入库）
# 生成强密钥：openssl rand -base64 48

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-strong-db-password
BUDDY_DB_NAME=buddy

# --- 后端密钥（生产必填，缺失则 compose/应用启动报错）---
# HS256 要求 >=32 字节
BUDDY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# C 端（member 域）专用：必须与 BUDDY_JWT_SECRET 不同（共密钥 = 两类令牌不可区分）
# 不配或短于 32 字节时应用直接启动失败（故意不给默认值）
BUDDY_MEMBER_JWT_SECRET=change-me-to-another-random-string-of-at-least-32-bytes
# 手机号/身份证哈希与字段加密的 pepper（内部会派生出两个不同密钥，不直接当 AES 密钥用）
BUDDY_MEMBER_PHONE_PEPPER=change-me-to-a-random-pepper-at-least-32-bytes
# 无真实实名/短信通道时才置 true；生产必须留 false（实名自动通过 = 实名制度形同虚设）
BUDDY_MEMBER_MOCK_REALNAME=false
# MOCK 短信通道下把验证码回显在响应里（仅便于联调）；接真实通道后必须 false
BUDDY_MEMBER_SMS_ECHO=false
BUDDY_ADMIN_USERNAME=admin
BUDDY_ADMIN_PASSWORD=change-me-strong-admin-password

# --- 可选：多租户开关（默认 false=单租户；开启前确认已按租户规划数据）---
BUDDY_TENANT_ENABLED=false
