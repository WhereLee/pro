# 复制为 .env 并填入真实值（.env 切勿提交仓库；.gitignore 已忽略 *.env.local，请自行确保 .env 不入库）
# 生成强密钥：openssl rand -base64 48

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-strong-db-password
BUDDY_DB_NAME=buddy

# --- 后端密钥（生产必填，缺失则 compose/应用启动报错）---
# HS256 要求 >=32 字节
BUDDY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
BUDDY_ADMIN_USERNAME=admin
BUDDY_ADMIN_PASSWORD=change-me-strong-admin-password

# --- 可选：多租户开关（默认 false=单租户；开启前确认已按租户规划数据）---
BUDDY_TENANT_ENABLED=false
