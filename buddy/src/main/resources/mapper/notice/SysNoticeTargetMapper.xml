<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrs.buddy.framework.modules.notice.mapper.SysNoticeTargetMapper">

    <delete id="deleteByNoticeId">
        DELETE FROM sys_notice_target WHERE notice_id = #{noticeId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO sys_notice_target(notice_id, target_id) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.noticeId}, #{item.targetId})
        </foreach>
    </insert>

</mapper>
