# ============================================================
# buddy monorepo .gitignore  (backend: buddy/  frontend: buddy-ui/)
# ============================================================

# --- build output ---
target/
dist/

# --- dependencies ---
node_modules/
_old_node_modules/

# --- runtime data & logs ---
uploads*/
*.log
.logs/

# --- 压测运行产物（JMeter/k6）---
*.jtl

# --- legacy standalone project at repo root (pending removal) ---
# NOTE: leading slash is critical — "/src" ONLY ignores repo-root src/,
#       NOT buddy/src or buddy-ui/src (real source code).
/src/

# --- stray validation screenshots at repo root ---
/*.png

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.reasonix/
.DS_Store
Thumbs.db

# --- local env / secrets ---
*.env.local

# --- Playwright 运行产物 ---
test-results/
playwright-report/

# --- 个人求职/叙事材料（勿入公开仓库） ---
/buddy-upgrade-narrative.md
