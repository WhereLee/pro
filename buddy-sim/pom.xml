<?xml version="1.0" encoding="UTF-8"?>
<!--
  buddy-sim：换电柜的虚拟设备工程（协议的规范性设备实现）。
  工程规范见 ../buddy/docs/swap-simulator.md。

  两条硬约束刻意写在这里：
  1 不依赖 buddy 的任何 Java 类（零代码共享，防同源错误互相掩盖）—— 因此没有 <parent>，也不引 buddy；
  2 独立产物，绝不进生产 jar：本模块的能力包含伪造报文、错签名、重放、假 ACK，
    打进生产镜像等于随服务发布一个攻击工具。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lrs</groupId>
    <artifactId>buddy-device-sim</artifactId>
    <version>1.0.0</version>
    <name>buddy-sim</name>
    <description>换电柜虚拟设备（协议规范性实现 + 故障注入）</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- jackson 版本与云侧（Spring Boot 管理）对齐：2.18.2 带 CRITICAL 级嵌套深度 DoS 告警，
             会被 CI 的 Trivy 硬门禁拦下；本工程自己钉版本时必须跟着升级，不能靠“只是个模拟器”放过。 -->
        <jackson.version>2.19.2</jackson.version>
        <hivemq-mqtt-client.version>1.3.3</hivemq-mqtt-client.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.26.3</assertj.version>
    </properties>

    <!--
      netty 版本管理： hivemq-mqtt-client 不声明 netty 版本时会拉到 4.1.99.Final（带 CRITICAL CVE）。
      先用 netty-bom 对齐到云侧同小的 4.1.135，再**逐件覆盖**到 4.1.137.Final：
      CVE-2026-75595 修在 4.1.137 / 4.2.17，而本地镜像仓库只有 netty-bom 的 4.1.135（各件 4.1.137 存在），
      所以不能直接依赖 bom 取 137。写在 BOM 之前，显式条目优先级高于导入的 BOM。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency><groupId>io.netty</groupId><artifactId>netty-buffer</artifactId><version>4.1.137.Final</version></dependency>
            <dependency><groupId>io.netty</groupId><artifactId>netty-codec</artifactId><version>4.1.137.Final</version></dependency>
            <dependency><groupId>io.netty</groupId><artifactId>netty-common</artifactId><version>4.1.137.Final</version></dependency>
            <dependency><groupId>io.netty</groupId><artifactId>netty-handler</artifactId><version>4.1.137.Final</version></dependency>
            <dependency><groupId>io.netty</groupId><artifactId>netty-resolver</artifactId><version>4.1.137.Final</version></dependency>
            <dependency><groupId>io.netty</groupId><artifactId>netty-transport</artifactId><version>4.1.137.Final</version></dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.135.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <version>${hivemq-mqtt-client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 仅为集成测试需要一个**与设备侧实现无关**的 MQTT 5 Broker（标准实现、不是 buddy 的代码）；
             不进 compile 作用域，避免模拟器自带一个 broker 被人误用于生产。 -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-mqtt</artifactId>
            <version>4.5.14</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>buddy-sim</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.lrs.sim.SwapSimApp</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
